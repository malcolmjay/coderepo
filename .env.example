# Copy to .env for local use, then: set -a; source .env; set +a
# .env files are not automatically loaded and must never be committed.
DEBUG=true
SITE_ORIGIN=http://127.0.0.1:8000
# Production: DEBUG=false and a cryptographically random secret, shared by web + worker.
# SECRET_KEY=
# DATABASE_URL=postgresql://user:password@host:5432/camera_hacks
# TRUST_PROXY_HEADERS=true
# S3_BUCKET=
AWS_REGION=ca-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DEFAULT_FROM_EMAIL='Camera Hacks <downloads@your-verified-domain.example>'
# EMAIL_HOST=
EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
